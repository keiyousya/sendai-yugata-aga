---
import '@fontsource/m-plus-1p/400.css';
import '@fontsource/m-plus-1p/500.css';
import '@fontsource/m-plus-1p/700.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "仙台でAGA治療。デュタステリド内服による薄毛治療を提供。夜21時まで診療、土日も対応。勾当台公園駅徒歩2分。" } = Astro.props;

const siteUrl = "https://sendai-yugata-aga.koutoudai-yugata-naika.clinic";
const currentPath = Astro.url.pathname;
const canonicalUrl = currentPath === "/" ? siteUrl : `${siteUrl}${currentPath}`;
const ogImage = `${siteUrl}/og-image.jpg`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": siteUrl,
  "name": "仙台夕方AGA",
  "description": description,
  "url": siteUrl,
  "image": ogImage,
  "medicalSpecialty": "Dermatology",
  "availableService": {
    "@type": "MedicalProcedure",
    "name": "AGA治療（デュタステリド内服）",
    "description": "男性型脱毛症（AGA）に対するデュタステリド内服による治療"
  },
  "address": {
    "@type": "PostalAddress",
    "postalCode": "980-0803",
    "addressLocality": "仙台市青葉区",
    "addressRegion": "宮城県",
    "addressCountry": "JP",
    "streetAddress": "国分町3丁目8-1 勾当台ビル4階"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.2682,
    "longitude": 140.8694
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "17:00",
      "closes": "21:00"
    }
  ],
  "priceRange": "自由診療"
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="仙台夕方AGA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#1a1a2e" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <style>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html{scroll-behavior:smooth;overflow-x:clip}
      body{margin:0}
      .header{position:fixed;top:0;left:0;right:0;z-index:1000}
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #1a1a2e;
    --color-primary-light: #16213e;
    --color-accent: #0f3460;
    --color-highlight: #e94560;
    --color-highlight-hover: #d63d56;

    --color-text: #222;
    --color-text-light: #fff;
    --color-text-muted: #666;

    --color-bg: #fafafa;
    --color-bg-dark: #1a1a2e;
    --color-bg-section: #f5f5f5;

    --color-border: #e0e0e0;

    --gradient-primary: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
    font-size: 18px;
  }

  body {
    font-family: "M PLUS 1p", -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
    line-height: 1.8;
    color: var(--color-text);
    background-color: var(--color-bg);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  ul {
    list-style: none;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: 80px 0;
    scroll-margin-top: 80px;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 48px;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .section-title span {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-top: 8px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    html {
      font-size: 16px;
    }

    .section {
      padding: 60px 0;
    }

    .section-title {
      font-size: 1.5rem;
      margin-bottom: 36px;
    }
  }
</style>
