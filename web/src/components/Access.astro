---

<section id="access" class="section">
  <div class="container">
    <h2 class="section-title">
      アクセス・予約
      <span>ACCESS</span>
    </h2>

    <div class="clinic-name">勾当台夕方内科クリニック</div>
    <div class="access-top">
      <div class="access-info">
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">住所</div>
            <div class="info-value">
              〒980-0803<br />
              宮城県仙台市青葉区国分町3丁目8-1<br />
              勾当台ビル4階
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">アクセス</div>
            <div class="info-value">
              地下鉄南北線「勾当台公園駅」<br />
              北1出口より徒歩2分
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">診療時間</div>
            <div class="info-value">
              17:00〜21:00<br />
              <span class="sub">水・木・金・土・日</span>
            </div>
          </div>

          <div class="info-item">
            <div class="info-label">休診日</div>
            <div class="info-value">
              月曜・火曜・祝日
            </div>
          </div>
        </div>
      </div>

      <div class="access-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3131.8!2d140.8694!3d38.2682!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f8a281f0b0b0b0b%3A0x0!2z5a6u5Z-O55yM5LuZ5Y-w5biC6Z2S6JGJ5Yy65Zu95YiG55S677yT5LiB55uu77yY4oiS77yR!5e0!3m2!1sja!2sjp!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>

    <div class="reservation-box">
      <h3 class="reservation-title">ご予約・お問い合わせ</h3>
      <div class="reservation-content">
        <div class="reservation-methods">
          <a href="https://lin.ee/o8VUXOX" target="_blank" rel="noopener noreferrer" class="reservation-btn line">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            <span class="btn-content">
              <span class="btn-label">LINE予約（推奨）</span>
              <span class="btn-value">友だち追加して予約</span>
            </span>
          </a>
          <a href="tel:022-393-8689" class="reservation-btn phone">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span class="btn-content">
              <span class="btn-label">お電話</span>
              <span class="btn-value">022-393-8689</span>
            </span>
          </a>
        </div>
        <div class="reservation-notes">
          <div class="note-item">
            <span class="note-label">LINE予約の場合</span>
            <p class="note-text">主訴欄に<strong>「AGA処方希望」</strong>とご入力ください</p>
          </div>
          <div class="note-item">
            <span class="note-label">電話予約の場合</span>
            <p class="note-text">「AGA処方希望」とお伝えください</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    background: var(--color-bg-section);
  }

  .access-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
    margin-bottom: 48px;
  }

  .clinic-name {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .info-item {
    padding: 20px;
    background: #fff;
    border-radius: 12px;
  }

  .info-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-highlight);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-value {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .info-value .sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .access-map {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    min-height: 280px;
  }

  .access-map iframe {
    display: block;
  }

  .reservation-box {
    padding: 40px;
    background: var(--gradient-primary);
    border-radius: 20px;
    color: #fff;
  }

  .reservation-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 28px;
    text-align: center;
  }

  .reservation-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }

  .reservation-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .reservation-btn {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    transition: background 0.2s, transform 0.2s;
  }

  .reservation-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .reservation-btn.line {
    background: #06C755;
  }

  .reservation-btn.line:hover {
    background: #05b34c;
  }

  .btn-content {
    display: flex;
    flex-direction: column;
  }

  .btn-label {
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .btn-value {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .reservation-notes {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
  }

  .note-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .note-label {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-size: 0.75rem;
    width: fit-content;
  }

  .note-text {
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .note-text strong {
    color: #fff;
  }

  @media (max-width: 900px) {
    .access-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .info-grid {
      grid-template-columns: 1fr 1fr;
    }

    .access-map {
      min-height: 250px;
    }

    .reservation-box {
      padding: 28px;
    }

    .reservation-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .info-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .reservation-title {
      font-size: 1.1rem;
    }

    .btn-value {
      font-size: 1rem;
    }
  }
</style>
