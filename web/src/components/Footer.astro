<footer class="footer">
  <div class="footer-content container">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/logo.svg" alt="" class="footer-logo" />
        <img src="/logo-text.svg" alt="仙台夕方AGA" class="footer-logo-text" />
      </div>
      <div class="footer-clinic">
        医療機関：勾当台夕方内科クリニック
      </div>
    </div>
    <nav class="footer-nav">
      <a href="#about">AGAとは</a>
      <a href="#treatment">治療内容</a>
      <a href="#pricing">料金</a>
