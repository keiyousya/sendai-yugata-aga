<style>
  .footer {
    background: var(--color-primary);
    color: #fff;
    padding: 48px 0 32px;
  }

  .footer-content {
    text-align: center;
  }

  .footer-main {
    margin-bottom: 32px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }

  .footer-logo {
    height: 48px;
    width: auto;
  }

  .footer-logo-text {
    height: 32px;
    width: auto;
  }

  .footer-clinic {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .footer-nav a {
    font-size: 0.875rem;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .footer-nav a:hover {
    opacity: 1;
  }

  .footer-copyright {
    font-size: 0.75rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 40px 0 24px;
    }

    .footer-nav {
      gap: 16px;
    }
  }
</style>
