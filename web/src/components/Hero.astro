<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content container">
    <p class="hero-label">内科クリニックのAGA治療</p>
    <h1 class="hero-title">
      薄毛の悩み、<br />
      <span>内科</span>で相談。
    </h1>
    <p class="hero-subtitle">
      美容クリニックはちょっと…という方へ。<br />
      <strong>普通の内科</strong>でAGAのお薬を処方します。
    </p>
    <div class="hero-points">
      <div class="point">
        <svg class="point-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <span class="point-text">内科で処方</span>
      </div>
      <div class="point">
        <svg class="point-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="point-text">仙台市中心部</span>
      </div>
      <div class="point">
        <svg class="point-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="point-text">夜21時まで</span>
      </div>
      <div class="point">
        <svg class="point-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span class="point-text">土日も対応</span>
      </div>
    </div>
    <p class="hero-catch">仕事帰りにサッと受け取れます</p>
    <a href="#access" class="hero-cta">
      無料相談・予約はこちら
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 120px 0 80px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    z-index: -1;
  }

  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-content {
    text-align: center;
    color: #fff;
  }

  .hero-label {
    display: inline-block;
    padding: 8px 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 24px;
    letter-spacing: 0.1em;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }

  .hero-title span {
    color: var(--color-highlight);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 40px;
    line-height: 1.8;
  }

  .hero-subtitle strong {
    color: var(--color-highlight);
    font-weight: 600;
  }

  .hero-points {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .hero-catch {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 40px;
    opacity: 0.95;
  }

  .point {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
  }

  .point-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .point-text {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 18px 40px;
    background: var(--color-highlight);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 8px;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    background: var(--color-highlight-hover);
    transform: translateY(-2px);
  }

  .sp-only {
    display: none;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 100px 0 60px;
      min-height: auto;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .hero-points {
      gap: 12px;
    }

    .point {
      padding: 10px 16px;
    }

    .point-text {
      font-size: 0.8rem;
    }

    .hero-cta {
      padding: 16px 32px;
      font-size: 1rem;
    }

    .hero-catch {
      font-size: 0.95rem;
      margin-bottom: 32px;
    }

    .sp-only {
      display: inline;
    }
  }
</style>
